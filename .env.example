# Existing agent configuration
GEMINI_API_KEY=
SPREADSHEET_ID=
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
COOK_CHAT_ID=
# Required for budget access: an exact private @lid or @c.us ID. Financial
# commands and scheduled reports never fall back to an auto-detected chat.
PERSONAL_CHAT_ID=
USER_GOAL=""

# Optional cross-platform runtime storage. Leave these blank to preserve all
# existing Windows paths. On a Linux VM/container, set AGENT_DATA_DIR to a
# private persistent volume; the more specific paths override it when supplied.
AGENT_DATA_DIR=
WHATSAPP_AUTH_PATH=
WHATSAPP_BROWSER_EXECUTABLE=
WHATSAPP_HEADLESS=true
AGENT_STATUS_PATH=
WHATSAPP_QR_PATH=
WHATSAPP_AUDIT_LOG_PATH=
GOOGLE_TASKS_TOKEN_PATH=
STOCK_REPORTS_DIR=
BUDGET_REPORTS_DIR=
BUDGET_CATEGORY_RULES_PATH=

# Optional stock-news evidence controls. Sources are public metadata feeds only;
# inaccessible/paywalled article bodies are never fetched. Author scores must be
# based on a track record you reviewed, for example {"analyst handle":0.85}.
MARKET_SENTIMENT_LOOKBACK_DAYS=120
MARKET_REDDIT_ENABLED=true
MARKET_GDELT_ENABLED=true
MARKET_AUTHOR_REPUTATION_JSON={}
# Optional official X API v2 token; when blank, X is skipped (never scraped).
MARKET_X_BEARER_TOKEN=

# Optional Gmail receipt source. Run `npm run auth:budget` after configuring the
# OAuth client ID/secret, unless they already exist in the Tasks token file.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BUDGET_GMAIL_MESSAGE_LIMIT=250
BUDGET_GMAIL_TOKEN_PATH=

# Optional item-level enrichment from Swiggy's official read-only MCP. OAuth is
# initialized with `npm run auth:swiggy`; normal syncing runs only inside
# `npm start`. Instamart exposes a rolling 15-day window, retained for 90 days
# in the encrypted local cache. The SMS secret is used as the cache key unless
# a separate SWIGGY_ORDER_CACHE_SECRET is supplied.
SWIGGY_ORDER_HISTORY_ENABLED=true
SWIGGY_MCP_AUTH_DIR=
SWIGGY_ORDER_CACHE_PATH=
SWIGGY_ORDER_CACHE_SECRET=
SWIGGY_INSTAMART_CALLBACK_PORT=
SWIGGY_FOOD_CALLBACK_PORT=
SWIGGY_ORDER_SYNC_CRON="10 3 * * *"

# Optional monthly target, used only for remaining-budget calculations.
MONTHLY_BUDGET_INR=

# Android SMS coverage is mandatory for monthly budget reports. The full current
# month is scanned locally; only filtered transaction candidates are uploaded.
SMS_INGESTION_ENABLED=true
SMS_INGESTION_HOST=127.0.0.1
SMS_INGESTION_PORT=8787
SMS_INGESTION_SECRET=
SMS_INGESTION_SECRET_FILE=
SMS_TRANSACTION_STORE=
SMS_SCAN_STATE_PATH=
SMS_SCAN_MAX_AGE_HOURS=12
SMS_TLS_KEY_PATH=
SMS_TLS_CERT_PATH=

# A new installation does not unexpectedly generate the current month's missed
# report. Future missed reports are recovered automatically. Set true only when
# you intentionally want an immediate first catch-up.
BUDGET_ALLOW_INITIAL_CATCH_UP=false
