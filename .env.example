# Existing agent configuration
GEMINI_API_KEY=
SPREADSHEET_ID=
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
COOK_CHAT_ID=
PERSONAL_CHAT_ID=
USER_GOAL=""

# Optional Gmail receipt source. Run `npm run auth:budget` after configuring the
# OAuth client ID/secret, unless they already exist in the Tasks token file.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BUDGET_GMAIL_MESSAGE_LIMIT=250
BUDGET_GMAIL_TOKEN_PATH=

# Optional item-level enrichment from Swiggy's official read-only MCP. OAuth is
# initialized with `npm run auth:swiggy`; normal syncing runs only inside
# `npm start`. Instamart exposes a rolling 15-day window, retained for 90 days
# in the encrypted local cache. The SMS secret is used as the cache key unless
# a separate SWIGGY_ORDER_CACHE_SECRET is supplied.
SWIGGY_ORDER_HISTORY_ENABLED=true
SWIGGY_MCP_AUTH_DIR=
SWIGGY_ORDER_CACHE_PATH=
SWIGGY_ORDER_CACHE_SECRET=
SWIGGY_ORDER_SYNC_CRON="10 3 * * *"

# Optional monthly target, used only for remaining-budget calculations.
MONTHLY_BUDGET_INR=

# Android SMS coverage is mandatory for monthly budget reports. The full current
# month is scanned locally; only filtered transaction candidates are uploaded.
SMS_INGESTION_ENABLED=true
SMS_INGESTION_HOST=127.0.0.1
SMS_INGESTION_PORT=8787
SMS_INGESTION_SECRET=
SMS_INGESTION_SECRET_FILE=
SMS_TRANSACTION_STORE=
SMS_SCAN_STATE_PATH=
SMS_SCAN_MAX_AGE_HOURS=12
SMS_TLS_KEY_PATH=
SMS_TLS_CERT_PATH=

# A new installation does not unexpectedly generate the current month's missed
# report. Future missed reports are recovered automatically. Set true only when
# you intentionally want an immediate first catch-up.
BUDGET_ALLOW_INITIAL_CATCH_UP=false
