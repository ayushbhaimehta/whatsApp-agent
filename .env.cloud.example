# Copy this file to .env.cloud on the VM. Never commit .env.cloud.

# Gemini handles WhatsApp intent recognition, nutrition estimates, meal ideas,
# and best-effort budget merchant enrichment.
GEMINI_API_KEY=
# Leave blank to use the application's tested primary/fallback model list.
GEMINI_MODEL=

# Nutrition logging and WhatsApp routing.
SPREADSHEET_ID=
COOK_CHAT_ID=
# Required for budget access; must be the exact private @lid or @c.us chat ID.
PERSONAL_CHAT_ID=
USER_GOAL=""
WHATSAPP_HEADLESS=true
# Restart a genuinely stalled authenticated browser after two minutes. Values
# outside 30 seconds to 10 minutes fall back safely to 120000.
WHATSAPP_READY_TIMEOUT_MS=120000
# Docker Compose sets this to /data/whatsapp-web-cache. Leave it unset here.

# OAuth client used by Google Tasks and optional Gmail receipt ingestion.
# Token files themselves live under cloud-data/secrets (see compose.yaml).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BUDGET_GMAIL_MESSAGE_LIMIT=250

# Android SMS companion. Keep the API loopback-only; Tailscale Serve provides
# private HTTPS from the phone to the VM.
SMS_INGESTION_ENABLED=true
SMS_INGESTION_HOST=127.0.0.1
SMS_INGESTION_PORT=8787
SMS_SCAN_MAX_AGE_HOURS=12

# Optional item-level Swiggy Food and Instamart enrichment.
SWIGGY_ORDER_HISTORY_ENABLED=true
SWIGGY_ORDER_SYNC_CRON="10 3 * * *"

# Optional public-feed market sentiment controls for stock reports.
MARKET_SENTIMENT_LOOKBACK_DAYS=120
MARKET_REDDIT_ENABLED=true
MARKET_GDELT_ENABLED=true
# Only add an author after reviewing a real historical scorecard.
MARKET_AUTHOR_REPUTATION_JSON={}
# Optional official X API v2 token; when blank, X is skipped (never scraped).
MARKET_X_BEARER_TOKEN=

# Optional monthly target, in rupees.
MONTHLY_BUDGET_INR=

# Do not unexpectedly generate a missed report on the first cloud startup.
BUDGET_ALLOW_INITIAL_CATCH_UP=false

# Optional: when set, report links use this public/private base URL. When blank,
# the generated HTML files are sent directly through WhatsApp.
REPORT_PUBLIC_BASE_URL=
